# Copy to .env and fill values. Do not commit .env.

# Postmark transactional email (api/contact.php)
POSTMARK_TOKEN=
POSTMARK_FROM={{CONTACT_EMAIL}}
POSTMARK_TO={{CONTACT_EMAIL}}

# CORS allowed origin for contact form (set to production URL)
CORS_ORIGIN=https://mulligans-grille.com

# IndexNow (api/indexnow.php)
INDEXNOW_KEY=

# Cloudflare API (used by /purge-cache skill)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
